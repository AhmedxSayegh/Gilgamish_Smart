NODE_ENV=development
# Unified optional services (credentials remain server-side)
ROUTES_PROVIDER=google
GOOGLE_ROUTES_API_KEY=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gilgamish
DB_PASSWORD=replace-with-your-local-password
DB_NAME=gilgamish
DB_SSL=false
DESTINATIONS_PROVIDER=demo
FLIGHTS_PROVIDER=ignav
IGNAV_API_KEY=
HOTELS_PROVIDER=serpapi
# Set HOTELS_PROVIDER=serpapi to enable Google Hotels. Key is read ONLY from backend/.env.
SERPAPI_API_KEY=
# Per-process upstream attempts (cache hits are free); UTC day resets on restart.
SERPAPI_DAILY_LIMIT=100
SERPAPI_MINUTE_LIMIT=20
SERPAPI_CONCURRENCY=2
PLACES_PROVIDER=google
AI_PROVIDER=qwen
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
GOOGLE_PLACES_API_KEY=
SESSION_DAYS=7
# Enable only behind exactly one trusted reverse proxy.
TRUST_PROXY=false
